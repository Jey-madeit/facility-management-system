PORT=5000
MONGODB_URI=mongodb://localhost:27017/facility-management
JWT_SECRET=change_this_to_a_random_long_string_minimum_32_characters
JWT_EXPIRES_IN=6h
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Email Configuration for OTP
# Service: gmail, outlook, yahoo, or other SMTP services
EMAIL_SERVICE=gmail
# For Gmail: Use App Password (not regular password). Generate at https://myaccount.google.com/apppasswords
# For other services: Use your email service provider's credentials
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password-or-service-password

